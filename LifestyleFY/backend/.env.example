# Copy to .env for local dev. Cloud Run sets these via --set-env-vars / --set-secrets.

# --- GCP ---
GCP_PROJECT=shafay-nutrition
BQ_DATASET=nutrition
WORKOUT_SHEET_ID=PUT_SPREADSHEET_ID_HERE

# --- Secrets (locally: paste values; on Cloud Run: injected from Secret Manager) ---
GEMINI_API_KEY=
CHOMP_API_KEY=

# --- Gemini models ---
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_SMART=gemini-flash-latest

# --- Local dev toggles ---
# DEV_NO_AUTH=true skips Firebase token verification (uses uid=dev-user).
DEV_NO_AUTH=true
# USE_STUBS=true short-circuits Firestore/BigQuery/Gemini/Chomp so you can run
# the whole API offline with in-memory data. Open Food Facts still works (public).
USE_STUBS=true

# Comma-separated allowed origins for CORS (your Angular dev + Firebase Hosting URL).
CORS_ORIGINS=http://localhost:4200
